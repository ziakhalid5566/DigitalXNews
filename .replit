modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
SUPABASE_PROJECT_REF = "qyrkrmxggorpbcbjxihp"
SUPABASE_DB_REGION = "ap-southeast-1"
EXPO_PUBLIC_EAS_PROJECT_ID = "46de0768-0520-4087-90a4-ccfe39862351"

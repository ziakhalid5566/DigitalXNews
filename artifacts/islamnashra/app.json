{
  "expo": {
    "name": "Al-Madaris",
    "slug": "al-madaris",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "almadaris",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080F20"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.almadaris.app"
    },
    "android": {
      "package": "com.almadaris.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0D1B3E"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      ["expo-router", { "origin": "https://replit.com/" }],
      "expo-font",
      "expo-web-browser",
      ["expo-notifications", {
        "icon": "./assets/images/icon.png",
        "color": "#1D9BF0",
        "sounds": [],
        "androidMode": "default",
        "androidCollapsedTitle": "Al-Madaris"
      }]
    ],
    "extra": {
      "eas": {
        "projectId": "46de0768-0520-4087-90a4-ccfe39862351"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
